      "Final terminal loss:   0.488140\n"
     ]
    }
   ],
   "source": [
    "batch_size = 2048\n",
    "n_iterations = 2000 # this is enough for Y_0 to converge\n",
    "\n",
    "# Adam optimizer for Y0 and the network weights theta\n",
    "optimizer = torch.optim.Adam([Y0] + list(Z_nn.parameters()),lr=1e-2) #changed learning rate to 0.01 instead of 0.001\n",
    "\n",
    "\n",
    "def propagate_Y(Y0, Z_nn, dW, S):\n",
    "    # Y_{k+1} = Y_k + r Y_k dt + Z_theta(t_k, S_k)^T dW_k (formula to propagate Y)\n",
    "    M = S.shape[0]\n",
    "    Y = Y0 * torch.ones(M)\n",
    "    for k in range(N):\n",
    "        t = torch.full((M, 1), k * dt)\n",
    "        Z = Z_nn(t, S[:, k, :])                            # shape (M, d)\n",
    "        Y = Y + r * Y * dt + torch.sum(Z * dW[:, k, :], dim=1)\n",
    "    return Y\n",
    "\n",
    "loss_history = []\n",
    "Y0_history = []\n",
    "\n",
    "for it in range(n_iterations):\n",
    "    # New batch of simulated paths each iteration (batch size = 2,048)\n",
    "    S, dW = simulate_forward(batch_size)\n",
    "\n",
    "    # propagate Y_k from Y0 to Y_N\n",
    "    Y_N = propagate_Y(Y0, Z_nn, dW, S)\n",
    "\n",
    "    # Terminal loss\n",
    "    g_N = payoff(S[:, -1, :])\n",
    "    loss = torch.mean((Y_N - g_N) ** 2)                    # loss function\n",
    "\n",
    "    # Gradient step\n",
    "    optimizer.zero_grad()   # clear gradients from the previous iteration\n",
    "    loss.backward()         # gradients wrt Y0 and theta\n",
    "    optimizer.step()        # updates Y0 and theta\n",
    "\n",
    "    loss_history.append(loss.item())\n",
    "    Y0_history.append(Y0.item())\n",
    "\n",
    "    if it % 100 == 0 or it == n_iterations - 1:\n",
    "        print(f\"iter {it:5d} | loss {loss.item():.6f} | Y0 {Y0.item():.5f}\")\n",
    "        \n",
    "with torch.no_grad():                        # evaluation only, no training\n",
    "    S_eval, dW_eval = simulate_forward(100_000)\n",
    "    Y_N_eval = propagate_Y(Y0, Z_nn, dW_eval, S_eval)\n",
    "    final_loss = torch.mean((Y_N_eval - payoff(S_eval[:, -1, :])) ** 2).item()\n",
    "\n",
    "V_MC = 5.1806   # Monte Carlo benchmark from Step 1\n",
    "print(f\"\\nLearned Y0:            {Y0.item():.6f}\")\n",
    "print(f\"Monte Carlo benchmark: {V_MC:.6f}\")\n",
    "print(f\"Absolute difference:   {abs(Y0.item() - V_MC):.6f}\")\n",
    "print(f\"Final terminal loss:   {final_loss:.6f}\")"
   ]
  },
